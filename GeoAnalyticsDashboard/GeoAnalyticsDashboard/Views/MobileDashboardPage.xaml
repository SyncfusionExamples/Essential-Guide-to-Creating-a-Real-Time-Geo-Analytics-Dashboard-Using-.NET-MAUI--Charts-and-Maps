                                                    </Grid>
                                                </chart:RadialBarSeries.CenterView>
                                            </chart:RadialBarSeries>
                                            <chart:SfCircularChart.Legend>
                                                <chart:ChartLegend Placement="Bottom"/>
                                            </chart:SfCircularChart.Legend>
                                            <chart:SfCircularChart.TooltipBehavior>
                                                <chart:ChartTooltipBehavior Background ="#065f46"/>
                                            </chart:SfCircularChart.TooltipBehavior>
                                        </chart:SfCircularChart>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </tabView:SfTabItem>

                    <tabView:SfTabItem Header="Trends" TextColor="#065f46">
                        <Grid Padding="12">
                            <Border Stroke="#bbf7d0" StrokeThickness="1" BackgroundColor="#f0fdf4" Padding="12" StrokeShape="RoundRectangle 10">
                                <Grid>
                                    <Label Text="{Binding SelectedCountryName, StringFormat='EV Trend – {0}'}" 
                                           FontAttributes="Bold" FontSize="14" TextColor="#065f46" Margin="0,0,0,8"/>
                                    <chart:SfCartesianChart Margin="0,24,0,0">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:NumericalAxis Interval="1">
                                                <chart:NumericalAxis.PlotBands>
                                                    <chart:NumericalPlotBandCollection>
                                                        <chart:NumericalPlotBand Start="2022" End="2023" Fill="#dcfce7"/>
                                                    </chart:NumericalPlotBandCollection>
                                                </chart:NumericalAxis.PlotBands>
                                            </chart:NumericalAxis>
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis/>
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:SfCartesianChart.TrackballBehavior>
                                            <chart:ChartTrackballBehavior>
                                                <chart:ChartTrackballBehavior.LabelStyle>
                                                    <chart:ChartLabelStyle Background="#065f46" LabelFormat="0.00'%'"/>
                                                </chart:ChartTrackballBehavior.LabelStyle>
                                            </chart:ChartTrackballBehavior>
                                        </chart:SfCartesianChart.TrackballBehavior>
                                        <chart:SfCartesianChart.Series>
                                            <chart:LineSeries ItemsSource="{Binding BatterySeries}" XBindingPath="Year" YBindingPath="Value" 
                                                              Label="Battery EV" Fill="#16a34a" 
                                                              EnableAnimation="True" StrokeWidth="2.5"/>
                                            <chart:LineSeries ItemsSource="{Binding PlugInSeries}" XBindingPath="Year" YBindingPath="Value" 
                                                              Label="Plug-in Hybrid" Fill="#86efac" 
                                                              EnableAnimation="True" StrokeWidth="2.5"/>
                                        </chart:SfCartesianChart.Series>
                                        <chart:SfCartesianChart.Legend>
                                            <chart:ChartLegend Placement="Bottom"/>
                                        </chart:SfCartesianChart.Legend>
                                    </chart:SfCartesianChart>
                                </Grid>
                            </Border>
                        </Grid>
                    </tabView:SfTabItem>

                    <tabView:SfTabItem Header="Countries" TextColor="#065f46">
                        <Grid Padding="12">
                            <Border Stroke="#bbf7d0" StrokeThickness="1" BackgroundColor="#f0fdf4" Padding="12" StrokeShape="RoundRectangle 10">
                                <Grid RowDefinitions="Auto,*">
                                    <HorizontalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,3">
                                        <Label Text="Country by Battery Share" FontAttributes="Bold" FontSize="14" TextColor="#065f46" />
                                        <Border StrokeThickness="0"
                                                BackgroundColor="#e2e8f0"
                                                Padding="0"
                                                WidthRequest="18"
                                                HeightRequest="18"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                StrokeShape="Ellipse"
                                                ToolTipProperties.Text="{Binding CountryPieInfoTooltip}">
                                            <Label Text="i" FontAttributes="Bold" FontSize="12" TextColor="#065f46" 
                                                   Padding="0,0,0,3" HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <chart:SfCircularChart Grid.Row="1" x:Name="CountryPieChart" Margin="0,24,0,0">
                                        <chart:PieSeries ItemsSource="{Binding TopCountries}" 
                                                         ShowDataLabels="True" EnableTooltip="False" 
                                                         XBindingPath="Country" YBindingPath="Value" 
                                                         LabelContext="Percentage" EnableAnimation="True" 
                                                         PaletteBrushes="{Binding CustomBrushes}" 
                                                         ExplodeIndex="{Binding CountryExplodeIndex}" ExplodeRadius="10">
                                            <chart:PieSeries.DataLabelSettings>
                                                <chart:CircularDataLabelSettings UseSeriesPalette="False" 
                                                                                 LabelPlacement="Outer" 
                                                                                 SmartLabelAlignment="Shift" />
                                            </chart:PieSeries.DataLabelSettings>
                                        </chart:PieSeries>
                                        <chart:SfCircularChart.Legend>
                                            <chart:ChartLegend
                                                         ToggleSeriesVisibility="True"
                                                         Placement="Bottom">
                                                <chart:ChartLegend.ItemsLayout>
                                                    <FlexLayout x:Name="CountryLegendPanel"
                                                                 Direction="Row"
                                                                 Wrap="Wrap"
                                                                 JustifyContent="Center"
                                                                 AlignItems="Center"
                                                                 AlignContent="Start"
                                                                 VerticalOptions="Start"/>
                                                </chart:ChartLegend.ItemsLayout>
                                            </chart:ChartLegend>
                                        </chart:SfCircularChart.Legend>
                                    </chart:SfCircularChart>
                                </Grid>
                            </Border>
                        </Grid>
                    </tabView:SfTabItem>
                </tabView:SfTabView>
            </bottomSheet:SfBottomSheet.BottomSheetContent>
        </bottomSheet:SfBottomSheet>
    </Grid>
</ContentPage>